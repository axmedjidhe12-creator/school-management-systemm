PORT=5000
NODE_ENV=production

# Database Settings (Railway Managed MySQL or Local XAMPP)
# For Railway, use MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=school_management_db

# JWT Configuration
JWT_SECRET=replace_with_strong_production_jwt_secret
JWT_EXPIRES_IN=7d

# SendGrid (Twilio) Settings
SENDGRID_API_KEY=SG.your_actual_sendgrid_key
EMAIL_FROM=verified_sender@yourdomain.com

# Client URL (for CORS - point to your Vercel URL in prod)
CLIENT_URL=https://your-app.vercel.app
